# Copy this file to .env and fill in real values before starting the server.

# Port the HTTP server listens on
PORT=3000

# Admin login password (plaintext here only; scripts/set-admin-password.js
# hashes it with scrypt into data/app.db and you can delete it afterward).
ADMIN_PASSWORD=change-me-now

# Secret seed used to derive the rotating hourly IP-hash salts. This is the
# only thing separating a stored iphash from the address it came from -- with
# a known seed the entire IPv4 space can be enumerated against it, so leaving
# this at the example value is a hard startup error when NODE_ENV=production.
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_SALT_SEED=change-me-too

# Set to "production" on a real deployment. This makes placeholder secrets a
# startup error, forces Secure on the admin session cookie, and adds
# upgrade-insecure-requests to the CSP.
NODE_ENV=development

# Set to a number (e.g. 1) if running behind a reverse proxy, so Express
# trusts X-Forwarded-For for the client IP. Leave unset for direct exposure.
# Behind a proxy without this, every client shares one rate-limit bucket and
# one iphash, so the per-IP limits stop limiting anything.
TRUST_PROXY=

# Force the pure-JS TensorFlow backend even if @tensorflow/tfjs-node is
# installed and loadable. Useful if the native build misbehaves.
FORCE_TFJS_CPU=false
